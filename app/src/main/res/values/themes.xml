<resources>
    <!-- Tema escuro do app (fundo azul-marinho do logo): vale depois da abertura e evita piscar de branco -->
    <style name="Theme.MotoristaFinanceiro" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#080E20</item>
        <item name="android:statusBarColor">#080E20</item>
        <item name="android:navigationBarColor">#080E20</item>
    </style>

    <!-- Abertura do sistema (androidx.core:core-splashscreen): só o fundo azul-marinho, sem ícone. Logo em seguida
         a animação Lottie (ui/abertura/AberturaAnimada) assume e, quando o app carrega, vale o tema normal. -->
    <style name="Theme.MotoristaFinanceiro.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#080E20</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_vazio</item>
        <item name="postSplashScreenTheme">@style/Theme.MotoristaFinanceiro</item>
    </style>
</resources>
